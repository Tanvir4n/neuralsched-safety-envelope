# Copy to .env for local bare-metal runs. docker-compose sets these itself.
JWT_SECRET=neuralsched-dev-secret-change-me
DATABASE_URL=postgresql://neuralsched:neuralsched@localhost:5432/neuralsched
TELEMETRY_TICK_SECONDS=10
NUM_GPU_NODES=32
# Optional: real carbon signal. Leave blank to use the synthetic fallback curve.
ELECTRICITY_MAPS_TOKEN=
ELECTRICITY_MAPS_ZONE=DE
